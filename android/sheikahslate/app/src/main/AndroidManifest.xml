<?xml version="1.0" encoding="utf-8"?>
<!-- After SDL3's android-project template (3.4.16), with Sheikah Slate's activity. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Loopback HTTP bridge to the Zepp app on this phone (enabled by the player). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The game code build in the foreground with the screen off (BuildService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Game files used in place (Game Files > Game files: Use them in place): the picked romfs/ read by its path, no
         16 GB copy - only asked for when that's chosen (SheikahSlateActivity.pickGameFolderInPlace) -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- appCategory="game": on a large screen (smallest width 600 dp or more: the Galaxy Tab S10 Ultra) Android 16
         ignores screenOrientation, setRequestedOrientation and resizeableActivity for an app targeting API 36 - except
         for games. Without it the tablet turned upright shows the game in portrait. (It is also the category Android's
         game features read; One UI's Game Launcher may need the app added by hand when it isn't from a store.) -->
    <application
        android:label="WSword"
        android:icon="@mipmap/ic_launcher"
        android:appCategory="game"
        android:isGame="true"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:enableOnBackInvokedCallback="false"
        android:hardwareAccelerated="true">

        <!-- (API 36 only, the same landscape lock for a build that loses its game category: the opt-out that API 37
             removes) -->
        <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true" />

        <!-- SDL hints (SDL_ENV.*): landscape only (SDL would allow any orientation for a resizable window) -->
        <meta-data android:name="SDL_ENV.SDL_ORIENTATIONS" android:value="LandscapeLeft LandscapeRight" />

        <!-- simpleperf over adb on release builds (CPU profiles: docs/las/ANDROID-PORT.md); nothing else changes -->
        <profileable android:shell="true" />

        <!-- (Sheikah Slate, 0.2.8-slate.12) The game's activity is GameActivity (SheikahSlateActivity's code, the class it
             extends): the app's icons are the activity-aliases below, one enabled at a time - Settings > Look > App icon
             (SheikahSlateActivity.setAppIcon) switches them, the real launcher icon, and the app starts again. Android
             has no way for an app to give its launcher icon a picture at run time: the icons are built in
             (tools/make_app_icons.py). Everything that starts the app asks for its launcher entry
             (getLaunchIntentForPackage), whichever is enabled; the shortcuts name GameActivity. -->
        <activity
            android:name=".GameActivity"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
        </activity>
        <!-- the app's own icon (the player's picture since 0.2.8-slate.13) - the name the activity had before
             0.2.8-slate.12, so a home screen icon from before stays -->
        <activity-alias
            android:name=".SheikahSlateActivity"
            android:targetActivity=".GameActivity"
            android:icon="@mipmap/ic_launcher"
            android:label="WSword"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the app icon's long-press shortcuts (res/xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconSlate"
            android:targetActivity=".GameActivity"
            android:icon="@mipmap/ic_launcher_slate"
            android:label="WSword"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the app icon's long-press shortcuts (res/xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconMidnight"
            android:targetActivity=".GameActivity"
            android:icon="@mipmap/ic_launcher_midnight"
            android:label="WSword"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the app icon's long-press shortcuts (res/xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconDawn"
            android:targetActivity=".GameActivity"
            android:icon="@mipmap/ic_launcher_dawn"
            android:label="WSword"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the app icon's long-press shortcuts (res/xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconAncient"
            android:targetActivity=".GameActivity"
            android:icon="@mipmap/ic_launcher_ancient"
            android:label="WSword"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the app icon's long-press shortcuts (res/xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".IconForest"
            android:targetActivity=".GameActivity"
            android:icon="@mipmap/ic_launcher_forest"
            android:label="WSword"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the app icon's long-press shortcuts (res/xml/shortcuts.xml) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity-alias>
        <!-- the long-press "Choose driver" shortcut: a driver package picked before the game starts (no window of its
             own: the system's file picker, then the app again) -->
        <activity
            android:name=".DriverPickActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="true" />
        <service
            android:name=".BuildService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
    </application>
</manifest>
